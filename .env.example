# Option 1: Full connection string (takes priority)
# DATABASE_URL=postgres://user:pass@localhost:5432/hooks?sslmode=disable

# Option 2: Individual variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=hooks
# DB_PASSWORD=hooks
# DB_NAME=hooks
# DB_SSLMODE=disable

# Server
# PORT=8080
# BASE_URL=http://localhost:8080
